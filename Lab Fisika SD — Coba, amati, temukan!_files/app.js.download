'use strict';
const $=s=>document.querySelector(s), clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const items={magnet:['Magnet','magnet'],nail:['Paku besi','nail'],clip:['Klip baja','clip'],wood:['Kayu','wood'],plastic:['Plastik','plastic'],aluminium:['Aluminium','can'],rubber:['Karet','rubber'],block:['Balok','wood'],ball:['Bola','ball'],feather:['Bulu','feather'],lever:['Papan tuas','lever'],fulcrum:['Titik tumpu','fulcrum'],load:['Beban','load'],ramp:['Bidang miring','ramp'],pulley:['Katrol','pulley'],cup:['Air panas','cup'],metalspoon:['Sendok logam','spoon'],woodspoon:['Sendok kayu','woodspoon'],plasticspoon:['Sendok plastik','plasticspoon'],battery:['Baterai','battery'],lamp:['Lampu','lamp'],switch:['Sakelar','switch'],tester:['Dudukan uji','tester']};
const labs={
magnet:{icon:'🧲',tab:'Magnet',title:'Kenali kekuatan magnet',sub:'01 / MAGNET',modes:['Benda & magnet','Dua kutub'],shelf:['magnet','nail','clip','wood','plastic','aluminium','rubber'],steps:['Tarik magnet dan beberapa benda ke meja.','Geser magnet mendekati benda; amati geraknya.','Untuk kutub, tambahkan dua magnet dan balik salah satunya.'],note:'Besi dan baja tertarik magnet. Aluminium tidak menunjukkan tarikan pada percobaan ini.',question:'Apakah semua benda logam tertarik magnet?',answers:['Ya','Tidak'],answer:1,explain:'Besi dan baja tertarik, tetapi aluminium tidak pada percobaan ini.'},
force:{icon:'↘',tab:'Gaya',title:'Dorong dan jatuhkan benda',sub:'02 / GAYA & GERAK',modes:['Gaya gesek','Gravitasi'],shelf:['block','ball','feather'],steps:['Pilih gaya gesek atau gravitasi.','Tarik benda ke meja, lalu atur percobaan.','Tekan Dorong atau Jatuhkan dan bandingkan hasilnya.'],note:'Gravitasi memakai model tanpa hambatan udara. Pada kondisi ini, massa tidak mengubah percepatan jatuh.',question:'Dengan dorongan awal sama, balok meluncur lebih jauh di permukaan…',answers:['Licin','Kasar'],answer:0,explain:'Gaya gesek lebih kecil pada permukaan licin sehingga balok meluncur lebih jauh.'},
simple:{icon:'⚖',tab:'Pesawat Sederhana',title:'Angkat beban lebih mudah',sub:'03 / PESAWAT SEDERHANA',modes:['Tuas','Bidang miring','Katrol'],shelf:['lever','fulcrum','load'],steps:['Letakkan alat dan beban yang sesuai di meja.','Ubah titik tumpu, kemiringan, atau jenis katrol.','Tekan Uji untuk melihat gerak dan kebutuhan gaya.'],note:'Model ideal tanpa gesekan. Gaya lebih kecil memerlukan jarak gerak yang lebih panjang; energi tidak diciptakan.',question:'Bidang miring yang lebih landai memerlukan gaya…',answers:['Lebih kecil','Lebih besar'],answer:0,explain:'Lintasannya menjadi lebih panjang, tetapi gaya yang dibutuhkan lebih kecil.'},
heat:{icon:'♨',tab:'Panas',title:'Ke mana panas berpindah?',sub:'04 / PERPINDAHAN PANAS',modes:['Konduksi'],shelf:['cup','metalspoon','woodspoon','plasticspoon'],steps:['Letakkan gelas air panas di meja.','Tambahkan satu atau beberapa sendok.','Mulai pengamatan; bandingkan suhu gagangnya.'],note:'Ini percobaan virtual. Suhu dan waktu adalah ilustrasi, bukan hasil pengukuran laboratorium.',question:'Gagang sendok mana yang paling cepat menjadi panas?',answers:['Logam','Kayu'],answer:0,explain:'Logam menghantarkan panas lebih baik dibandingkan kayu dan plastik.'},
electric:{icon:'💡',tab:'Listrik',title:'Nyalakan lampumu',sub:'05 / LISTRIK SEDERHANA',modes:['Rangkaian','Uji bahan'],shelf:['battery','lamp','switch'],steps:['Letakkan baterai, lampu, dan sakelar.','Ketuk satu terminal bulat, lalu terminal lain untuk memasang kabel.','Tutup sakelar. Untuk uji bahan, tambahkan dudukan uji.'],note:'Gunakan baterai tegangan rendah pada praktik nyata dengan pendampingan guru. Jangan gunakan listrik stopkontak.',question:'Lampu menyala jika rangkaian…',answers:['Terbuka','Tertutup'],answer:1,explain:'Arus dapat mengalir ketika rangkaian membentuk lintasan tertutup melalui lampu.'}
};
let lab='magnet',mode=0,objects=[],selected=null,pending=null,uid=0,wires=[],terminal=null,flipped=false,closed=false,testMaterial='nail',running=false,elapsed=0,last=0,sim=null,heatTime=0,guideVisible=true;
let settings={surface:'licin',speed:2.5,height:2,mass:1,fulcrum:65,angle:20,pulley:'tetap'};
const stage=$('#stage');
function toast(t){$('#toast').textContent=t;$('#toast').classList.add('show');clearTimeout(toast.timer);toast.timer=setTimeout(()=>$('#toast').classList.remove('show'),2600)}
function svgArt(type,o={}){const flip=o.flip,hot=o.hot||0; const spoonColor=type==='woodspoon'?'#b88b55':type==='plasticspoon'?'#8fbbcc':'#b6c7cf';
const arts={
magnet:`<rect x="-63" y="-19" width="126" height="38" rx="5" fill="${flip?'#e65d48':'#1968b9'}" stroke="#315b7a" stroke-width="2"/><path d="M-58-19H0V19H-58Q-63 19-63 14V-14Q-63-19-58-19" fill="${flip?'#1968b9':'#e65d48'}"/><path d="M-59-14H59" stroke="white" opacity=".45"/><text x="-34" y="7" fill="white" font-weight="bold" text-anchor="middle" font-size="20">${flip?'S':'U'}</text><text x="33" y="7" fill="white" font-weight="bold" text-anchor="middle" font-size="20">${flip?'U':'S'}</text>`,
nail:'<path d="M-40 16L34-12" stroke="#6d8795" stroke-width="8"/><path d="M-40 16L-29 16L-33 8Z" fill="#6d8795"/><path d="M29-23L39 0" stroke="#71848c" stroke-width="9" stroke-linecap="round"/><path d="M-30 10L29-12" stroke="#e6eef0" stroke-width="2"/>',
clip:'<path d="M-23 9L12-18Q31-28 33-9Q34-3 27 3L-9 27Q-24 35-31 23Q-39 11-24 0L9-22Q17-27 22-18Q26-11 18-6L-13 16" fill="none" stroke="#718893" stroke-width="5" stroke-linecap="round"/><path d="M-23 9L12-18Q31-28 33-9" fill="none" stroke="#dfe8ed" stroke-width="2"/>',
wood:'<path d="M-44-16L-26-29L46-15L46 22L28 32L-44 16Z" fill="#d5a367" stroke="#b48a54"/><path d="M-44-16L28-2L46-15M28-2V32" fill="none" stroke="#ae7c43"/><path d="M-35-5L19 6M-35 4L19 15M-21-23L33-12" stroke="#b1844e" opacity=".6"/>',
plastic:'<g transform="rotate(-20)"><rect x="-53" y="-13" width="106" height="26" rx="3" fill="#c3e3ec" fill-opacity=".8" stroke="#83a9bc"/><path d="M-44-12V0M-34-12V-5M-24-12V0M-14-12V-5M-4-12V0M6-12V-5M16-12V0M26-12V-5M36-12V0M46-12V-5" stroke="#6c93a6"/></g>',
can:'<rect x="-25" y="-32" width="50" height="66" rx="10" fill="#bfcdd2" stroke="#859ca8"/><ellipse cy="-29" rx="24" ry="8" fill="#e0e7e8" stroke="#859ca8"/><ellipse cy="-29" rx="9" ry="3" fill="#8ba2aa"/><path d="M-15-16V22M-7-16V22" stroke="white" opacity=".65" stroke-width="4"/>',
rubber:'<path d="M-40-9L-21-25L40-5L40 16L23 29L-40 9Z" fill="#737e88" stroke="#536476"/><path d="M-40-9L23 10L40-5M23 10V29" fill="none" stroke="#9aa8ac"/>',
ball:'<circle r="26" fill="#eda052" stroke="#c47936" stroke-width="2"/><path d="M-23-12Q0 1 23-12M-24 12Q0-1 24 12M-5-25Q9 0-5 25" fill="none" stroke="#c47936" stroke-width="2"/><ellipse cx="-10" cy="-13" rx="7" ry="4" fill="#ffe4b8"/>',
feather:'<path d="M-30 23Q-34-29 24-27Q32 21-30 23" fill="#e8e5dc" stroke="#98aaa8"/><path d="M-38 34L20-22M-25 18L-24-9M-14 7L-11-20M-4-3L12 0" stroke="#98aaa8" fill="none" stroke-width="2"/>',
lever:'<rect x="-62" y="-9" width="124" height="18" rx="3" fill="#d6ae77" stroke="#b38852"/><path d="M-53-2H52" stroke="#b38852"/>',
fulcrum:'<path d="M0-30L34 27H-34Z" fill="#15989c" stroke="#0b747a" stroke-width="2"/><path d="M0-20L23 20" stroke="#67babb"/>',
load:'<rect x="-26" y="-21" width="52" height="48" rx="5" fill="#6f8396" stroke="#425b72" stroke-width="2"/><path d="M-11-21V-29Q0-40 11-29V-21" fill="none" stroke="#425b72" stroke-width="5"/><text y="10" font-size="15" text-anchor="middle" fill="white">1 kg</text>',
ramp:'<path d="M-60 29L60-30V29Z" fill="#b9d3cc" stroke="#579c98" stroke-width="2"/><path d="M-60 27L60-32" stroke="#258a89" stroke-width="6"/>',
pulley:'<path d="M0-40V-28" stroke="#526d79" stroke-width="5"/><circle r="25" fill="#bbcbd2" stroke="#526d79" stroke-width="5"/><circle r="7" fill="#526d79"/><path d="M-28 37V0A28 28 0 0 1 28 0V37" fill="none" stroke="#c39155" stroke-width="4"/>',
cup:'<path d="M-45-30L-35 46Q0 58 35 46L45-30" fill="#cce8ec" fill-opacity=".6" stroke="#7eacb8" stroke-width="3"/><path d="M-40-8L-34 44Q0 54 34 44L40-8Z" fill="#91c9dd" fill-opacity=".65"/><ellipse cy="-8" rx="40" ry="7" fill="#c0e3ed"/><ellipse cy="-30" rx="45" ry="8" fill="none" stroke="#7eacb8" stroke-width="3"/><path d="M45-18Q77-20 65 16Q62 24 39 23" fill="none" stroke="#7eacb8" stroke-width="5"/><path d="M-19-45Q-29-55-19-67M5-44Q-5-55 5-67M27-45Q17-55 27-67" fill="none" stroke="#aebfc1" stroke-width="3"/>',
battery:'<rect x="-50" y="-25" width="100" height="50" rx="8" fill="#ebaf55" stroke="#ba8b40" stroke-width="2"/><path d="M-43-25H-13V25H-43Q-50 25-50 18V-18Q-50-25-43-25" fill="#34566e"/><text x="-32" y="7" fill="white" font-size="20">−</text><text x="23" y="7" fill="#6b4a24" font-size="21">+</text><text y="49" text-anchor="middle" font-size="13" fill="#637c87">3 V</text>',
lamp:`${o.lit?'<circle cy="-12" r="62" fill="#ffd95d" opacity=".2"/><circle cy="-12" r="43" fill="#ffda65" opacity=".25"/>':''}<path d="M-14 22V10Q-42-10-23-34Q0-54 23-34Q42-10 14 10V22Z" fill="${o.lit?'#ffe68b':'#e2e9df'}" stroke="#9bafad" stroke-width="2"/><path d="M-8 13L-13-14L0-5L13-14L8 13" fill="none" stroke="${o.lit?'#e8a124':'#8d9c9f'}" stroke-width="3"/><rect x="-17" y="18" width="34" height="22" rx="4" fill="#91a5af"/><path d="M-15 24H15M-15 31H15" stroke="#d3e0e2"/><rect x="-43" y="40" width="86" height="12" rx="4" fill="#c6d7d1"/>`,
switch:`<rect x="-55" y="-15" width="110" height="35" rx="7" fill="#d9ded3" stroke="#a1b3b0"/><circle cx="-30" r="6" fill="#6c8794"/><circle cx="30" r="6" fill="#6c8794"/><path d="M-30 0L30 ${closed?0:-30}" stroke="#b18b46" stroke-width="7" stroke-linecap="round"/>`,
tester:'<rect x="-62" y="-23" width="124" height="47" rx="6" fill="#d5e7df" stroke="#84a69a"/><path d="M-48 0H-23M23 0H48" stroke="#768c95" stroke-width="8"/><rect x="-24" y="-12" width="48" height="24" rx="3" fill="#f3e0b5" stroke="#bc9b63"/>',
};
if(['spoon','woodspoon','plasticspoon'].includes(type))return `<g transform="rotate(25)"><ellipse cy="23" rx="16" ry="24" fill="${spoonColor}" stroke="#788e91"/><rect x="-6" y="-55" width="12" height="63" rx="6" fill="${spoonColor}" stroke="#788e91"/>${hot?`<rect x="-6" y="-55" width="12" height="63" rx="6" fill="#ef7847" opacity="${clamp(hot/70,0,.85)}"/>`:''}</g>`;
return arts[type]||arts.wood;
}
function icon(id){return `<svg viewBox="-76 -75 152 145" aria-hidden="true">${svgArt(items[id][1])}</svg>`}
function setup(){const l=labs[lab];$('#tabs').innerHTML=Object.entries(labs).map(([k,v])=>`<button data-lab="${k}" class="${k===lab?'active':''}" aria-pressed="${k===lab}"><span class="tab-icon">${v.icon}</span><span>${v.tab}</span></button>`).join('');$('#subject').textContent=l.sub;$('#title').textContent=l.title;$('#modes').innerHTML=l.modes.map((m,i)=>`<button data-mode="${i}" class="${i===mode?'active':''}" aria-pressed="${i===mode}">${m}</button>`).join('');let shelf=[...l.shelf];if(lab==='force')shelf=mode===0?['block']:['ball','block','feather'];if(lab==='simple')shelf=mode===0?['lever','fulcrum','load']:mode===1?['ramp','load']:['pulley','load'];if(lab==='electric'&&mode===1)shelf.push('tester');$('#shelf').innerHTML=shelf.map(id=>`<button class="material" data-item="${id}" aria-label="Pilih ${items[id][0]}">${icon(id)}${items[id][0]}</button>`).join('');$('#count').textContent=shelf.length+' bahan';$('#steps').innerHTML=l.steps.map(t=>`<li>${t}</li>`).join('');$('#note').textContent=l.note;$('#question').textContent=l.question;$('#feedback').textContent='';$('#answers').innerHTML=l.answers.map((a,i)=>`<button data-answer="${i}">${a}</button>`).join('');$('#instruction').textContent=lab==='electric'?'Tarik komponen, lalu ketuk terminal bulat untuk menyambung kabel.':'Tarik bahan ke meja, atau pilih bahan lalu ketuk meja.';setControls();result('Tambahkan alat dan bahan untuk memulai penemuanmu.');render();}
function setControls(){let h='';if(lab==='magnet')h='<button data-action="flip">⇄ Balik kutub</button><button class="outline" data-action="magnet2">＋ Magnet kedua</button>';if(lab==='force')h=mode===0?'<label>Permukaan <select id="surface"><option value="licin">Licin (μ 0,10)</option><option value="kasar">Kasar (μ 0,40)</option></select></label><label>Dorongan <input id="speed" type="range" min="1" max="4" step=".5" value="2.5"><output id="speedVal">2,5 m/s</output></label><button data-action="push">▶ Dorong</button>':'<label>Tinggi <input id="height" type="range" min="1" max="5" step=".5" value="2"><output id="heightVal">2 m</output></label><label>Massa <select id="mass"><option value="1">1 kg</option><option value="3">3 kg</option></select></label><button data-action="drop">↓ Jatuhkan</button>';if(lab==='simple')h=mode===0?'<label>Titik tumpu <input id="fulcrum" type="range" min="25" max="80" value="65"><output id="fulcrumVal">65%</output></label><button data-action="simple">▶ Uji tuas</button>':mode===1?'<label>Kemiringan <input id="angle" type="range" min="10" max="45" value="20"><output id="angleVal">20°</output></label><button data-action="simple">▶ Angkat beban</button>':'<label>Katrol <select id="pulley"><option value="tetap">Tetap</option><option value="bergerak">Bergerak</option></select></label><button data-action="simple">▶ Tarik tali</button>';if(lab==='heat')h='<button data-action="heat">▶ Mulai pengamatan</button><button class="outline" data-action="pause">Ⅱ Jeda</button>';if(lab==='electric')h='<button data-action="switch">⏻ Tutup sakelar</button><button class="outline" data-action="auto">⌁ Sambungkan otomatis</button><button class="outline" data-action="clearwires">Hapus kabel</button>'+(mode===1?'<label>Bahan uji <select id="testMaterial"><option value="nail">Besi</option><option value="aluminium">Aluminium</option><option value="wood">Kayu</option><option value="plastic">Plastik</option><option value="rubber">Karet</option></select></label>':'');$('#controls').innerHTML=h;}
function result(t,r=''){$('#result').textContent=t;$('#readout').textContent=r}
function choose(id){pending=id;selected=null;$('#remove').hidden=true;$('#selection').textContent=items[id][0]+' dipilih · ketuk meja';document.querySelectorAll('.material').forEach(b=>b.classList.toggle('selected',b.dataset.item===id));render()}
function clearSelection(){pending=null;document.querySelectorAll('.material').forEach(b=>b.classList.remove('selected'));$('#remove').hidden=!selected;$('#selection').textContent=selected?(items[objects.find(o=>o.uid===selected)?.id]?.[0]||'Benda')+' dipilih':'Siap bereksperimen'}
function add(id,x,y){if(objects.length>=14){toast('Meja penuh. Hapus benda atau tekan Ulangi.');return}if(['electric','heat','simple','force'].includes(lab)&&objects.some(o=>o.id===id)){toast('Komponen ini sudah ada di meja.');return}let o={id,x:clamp(x,75,725),y:clamp(y,85,350),uid:++uid,flip:false,temp:25};objects.push(o);selected=o.uid;pending=null;clearSelection();if(lab==='heat')arrangeHeat();if(lab==='force')arrangeForce();if(lab==='simple')arrangeSimple();evaluate();render()}
const has=id=>objects.some(o=>o.id===id);
function reset(){objects=[];selected=null;pending=null;wires=[];terminal=null;closed=false;testMaterial='nail';running=false;elapsed=0;sim=null;heatTime=0;settings={surface:'licin',speed:2.5,height:2,mass:1,fulcrum:65,angle:20,pulley:'tetap'};setup();clearSelection()}
function arrangeHeat(){let cup=objects.find(o=>o.id==='cup');if(cup){cup.x=155;cup.y=245}objects.filter(o=>/spoon/.test(o.id)).forEach((o,i)=>{o.x=310+i*115;o.y=230})}
function arrangeForce(){objects.forEach((o,i)=>{o.x=mode===0?105:200+i*185;o.y=mode===0?300:95});running=false;sim=null;elapsed=0}
function arrangeSimple(){running=false;sim=null;elapsed=0}
function evaluate(){if(lab==='electric')return evaluateElectric();if(lab==='simple')return evaluateSimple();if(lab==='heat'){result(has('cup')?'Tambahkan sendok lalu mulai pengamatan.':'Letakkan air panas virtual dan sendok di meja.');return}if(lab==='force'){result(mode===0?'Balok siap didorong. Bandingkan jarak luncurnya di dua permukaan.':'Semua benda jatuh dengan percepatan sama pada model tanpa hambatan udara.');return}let mags=objects.filter(o=>o.id==='magnet');if(!mags.length)result('Letakkan magnet untuk menguji benda.');else result('Geser magnet mendekati benda. Paku besi dan klip baja dapat tertarik; kayu, plastik, karet, dan aluminium tidak.');}
function evaluateSimple(){const need=mode===0?['lever','fulcrum','load']:mode===1?['ramp','load']:['pulley','load'];const missing=need.filter(id=>!has(id));if(missing.length){result('Tambahkan: '+missing.map(id=>items[id][0]).join(', ')+'.');return false}if(mode===0){const p=settings.fulcrum/100,force=9.8*(1-p)/p;result('Titik tumpu mendekati beban membuat lengan kuasa lebih panjang. Tekan Uji tuas untuk mengangkatnya.',`Gaya kuasa: ${force.toFixed(1)} N · berat beban: 9,8 N`)}if(mode===1){let a=settings.angle*Math.PI/180;result('Semakin landai bidang, semakin kecil gaya yang dibutuhkan dan semakin panjang lintasannya.',`Gaya: ${(9.8*Math.sin(a)).toFixed(1)} N · lintasan untuk naik 1 m: ${(1/Math.sin(a)).toFixed(2)} m`)}if(mode===2){const moving=settings.pulley==='bergerak';result(moving?'Katrol bergerak ditopang dua bagian tali. Gaya menjadi setengah, jarak tarikan menjadi dua kali.':'Katrol tetap mengubah arah gaya. Besar gaya ideal tetap sama dengan berat beban.',`Gaya: ${moving?'4,9':'9,8'} N · tarikan untuk naik 1 m: ${moving?'2':'1'} m`)}return true}
function terminalXY(t){const [id,side]=t.split(':');const o=objects.find(o=>o.uid===Number(id));return o?{x:o.x+(side==='a'?-65:65),y:o.y+12}:null}
function evaluateElectric(){const battery=objects.find(o=>o.id==='battery'),lamp=objects.find(o=>o.id==='lamp'),sw=objects.find(o=>o.id==='switch'),tester=objects.find(o=>o.id==='tester');let graph={};function edge(a,b){(graph[a]??=[]).push(b);(graph[b]??=[]).push(a)}wires.forEach(([a,b])=>edge(a,b));objects.forEach(o=>{if((o.id==='switch'&&closed)||(o.id==='tester'&&['nail','aluminium'].includes(testMaterial)))edge(o.uid+':a',o.uid+':b')});function path(a,b){const q=[a],seen=new Set(q);while(q.length){let n=q.shift();if(n===b)return true;for(const v of graph[n]||[])if(!seen.has(v)){seen.add(v);q.push(v)}}return false}let lit=false,short=false;if(battery&&lamp){const ba=battery.uid+':a',bb=battery.uid+':b',la=lamp.uid+':a',lb=lamp.uid+':b';short=path(ba,bb);lit=!short&&((path(ba,la)&&path(lb,bb))||(path(ba,lb)&&path(la,bb)))}if(lamp)lamp.lit=lit;let text='Tambahkan baterai, lampu, dan sakelar, kemudian sambungkan terminalnya.';if(battery&&lamp&&sw)text=lit?'Lampu menyala! Rangkaian tertutup melalui lampu sehingga arus dapat mengalir.':short?'Hubung singkat: kedua kutub baterai terhubung tanpa melalui lampu. Hapus kabel lalu susun ulang.':!closed?'Sakelar terbuka. Tutup sakelar setelah semua komponen tersambung.':tester&&!['nail','aluminium'].includes(testMaterial)?'Bahan uji adalah isolator. Jalur melalui dudukan terputus sehingga lampu padam.':'Lampu padam. Periksa kabel: buat satu lintasan dari baterai, melalui lampu dan sakelar, kembali ke baterai.';result(text,lit?'Rangkaian tertutup · lampu menyala':'Lampu padam');return lit}
function autoWire(){const b=objects.find(o=>o.id==='battery'),l=objects.find(o=>o.id==='lamp'),s=objects.find(o=>o.id==='switch'),t=objects.find(o=>o.id==='tester');if(!b||!l||!s||(mode===1&&!t)){toast('Tambahkan baterai, lampu, sakelar'+(mode===1?', dan dudukan uji.':'.'));return}b.x=185;b.y=145;l.x=595;l.y=145;s.x=595;s.y=320;if(t){t.x=185;t.y=320}let chain=t?[b,l,s,t]:[b,l,s];wires=chain.map((o,i)=>[o.uid+':b',chain[(i+1)%chain.length].uid+':a']);terminal=null;evaluateElectric();render()}
function label(x,y,t,color='#58727c',size=14){return `<text x="${x}" y="${y}" fill="${color}" font-size="${size}" text-anchor="middle">${t}</text>`}
function render(){let s='<defs><filter id="shadow" x="-50%" y="-50%" width="200%" height="200%"><feDropShadow dx="0" dy="5" stdDeviation="4" flood-color="#254b5c" flood-opacity=".12"/></filter></defs>';$('#empty').style.display=objects.length?'none':'flex';
if(lab==='force'&&objects.length){if(mode===0){s+=`<rect x="45" y="335" width="710" height="23" rx="6" fill="${settings.surface==='kasar'?'#c0aa83':'#b6d3d9'}"/>${settings.surface==='kasar'?Array.from({length:60},(_,i)=>`<path d="M${50+i*11} 337l5 10" stroke="#9c845e"/>`).join(''):''}`;for(let i=0;i<7;i++)s+=label(105+i*95,385,`${i} m`,'#8b9c9d',12);s+=label(410,420,'Dorongan awal sama → bandingkan jarak luncur','#6b8b8c',13)}else{s+='<path d="M140 370H710" stroke="#a1bba8" stroke-width="8"/>';s+=label(400,410,'Tanpa hambatan udara · g = 9,8 m/s²','#6b8b8c',13)}}
if(lab==='simple'&&objects.length){s+=renderSimple();}else if(lab==='heat'&&objects.length){s+='<rect x="230" y="250" width="480" height="90" rx="23" fill="#a9d8e2" opacity=".55"/><path d="M245 252Q355 235 465 252T695 252" fill="none" stroke="#80bbc9" stroke-width="3"/>';s+=label(470,375,'Air panas virtual: 80 °C','#48899d',15);}
if(lab==='electric'){for(const [a,b]of wires){let p=terminalXY(a),q=terminalXY(b);if(p&&q){let bend=(p.x+q.x)/2;s+=`<path d="M${p.x} ${p.y}C${bend} ${p.y},${bend} ${q.y},${q.x} ${q.y}" fill="none" stroke="#e88e54" stroke-width="5" stroke-linecap="round"/>`}}}
if(!(lab==='simple'&&objects.length)){for(const o of objects){const name=items[o.id][0];s+=`<g data-uid="${o.uid}" transform="translate(${o.x},${o.y})">${selected===o.uid?'<rect x="-74" y="-73" width="148" height="146" rx="15" fill="none" stroke="#138d95" stroke-dasharray="5 5" stroke-width="2"/>':''}<g filter="url(#shadow)">${svgArt(items[o.id][1],{flip:o.flip,lit:o.lit,hot:o.temp-25})}</g>${label(0,lab==='heat'?88:76,name,'#577381',12)}${lab==='heat'&&/spoon/.test(o.id)?label(0,-85,`${o.temp.toFixed(1)} °C`,'#b76b3a',16):''}${lab==='electric'?['a','b'].map(side=>`<circle data-terminal="${o.uid}:${side}" cx="${side==='a'?-65:65}" cy="12" r="10" fill="${terminal===o.uid+':'+side?'#f4c25a':'#fffefa'}" stroke="#148f99" stroke-width="3"/>`).join(''):''}</g>`}}
stage.innerHTML=s;}
function renderSimple(){let s='',progress=sim?.progress||0;const complete=mode===0?has('lever')&&has('fulcrum')&&has('load'):mode===1?has('ramp')&&has('load'):has('pulley')&&has('load');if(!complete){return objects.map((o,i)=>`<g data-uid="${o.uid}" transform="translate(${190+i*170},225)">${svgArt(items[o.id][1])}${label(0,85,items[o.id][0])}</g>`).join('')}
if(mode===0){const px=160+480*settings.fulcrum/100,ang=-progress*12;s+=`<g transform="translate(${px},300)"><path d="M0-10L36 55H-36Z" fill="#15989c"/><g transform="rotate(${ang})"><rect x="${160-px}" y="-18" width="480" height="18" rx="5" fill="#d5a36a"/><g transform="translate(${620-px},-44)">${svgArt('load')}</g><path d="M${185-px}-95v55m-12-15l12 16 12-16" fill="none" stroke="#e79847" stroke-width="6"/></g></g>`;s+=label(180,405,'Kuasa ↓');s+=label(620,405,'Beban ↑');s+=label(px,380,'Titik tumpu','#138d95',13)}
if(mode===1){let a=settings.angle*Math.PI/180,len=510,h=len*Math.sin(a),x=140,y=345;let p=progress*.8+.08;s+=`<path d="M${x} ${y}L${x+len*Math.cos(a)} ${y-h}V${y}Z" fill="#c2dcd2" stroke="#6aaba0" stroke-width="3"/><path d="M${x} ${y}L${x+len*Math.cos(a)} ${y-h}" stroke="#169795" stroke-width="7"/><g transform="translate(${x+len*Math.cos(a)*p},${y-h*p-30}) rotate(${-settings.angle})">${svgArt('load')}<path d="M30 0h70m-12-9l13 9-13 9" fill="none" stroke="#e79847" stroke-width="5"/></g>`;s+=label(420,400,`Kemiringan ${settings.angle}° · beban 1 kg`)}
if(mode===2){let moving=settings.pulley==='bergerak',cy=moving?240-progress*85:110,loadY=moving?cy+75:290-progress*100;s+='<rect x="190" y="55" width="420" height="13" rx="5" fill="#79978f"/>';s+=`<path d="M320 67V${cy}" stroke="#6e858b" stroke-width="4"/><g transform="translate(320,${cy})">${svgArt('pulley')}</g>`;if(moving){s+=`<path d="M292 65V${cy}Q320 ${cy+57} 348 ${cy}V90H500V${190+progress*170}" fill="none" stroke="#c39155" stroke-width="5"/>`}else{s+=`<path d="M292 ${loadY}V110Q320 54 348 110V${220+progress*100}" fill="none" stroke="#c39155" stroke-width="5"/>`}s+=`<path d="M${moving?320:292} ${moving?cy+26:loadY-25}V${loadY}" stroke="#c39155" stroke-width="4"/><g transform="translate(${moving?320:292},${loadY+22})">${svgArt('load')}</g>`;s+=label(520,385,moving?'Tarik 2 m → beban naik 1 m':'Tarik 1 m → beban naik 1 m')}
return s;}
function act(action){if(action==='flip'){let o=objects.find(o=>o.uid===selected&&o.id==='magnet')||objects.filter(o=>o.id==='magnet').at(-1);if(!o){toast('Letakkan magnet terlebih dahulu.');return}o.flip=!o.flip;selected=o.uid;clearSelection();result('Kutub magnet dibalik. Dekatkan dengan magnet lain untuk menguji tarik atau tolak.');render()}if(action==='magnet2'){add('magnet',objects.some(o=>o.id==='magnet')?570:250,220)}if(action==='push'||action==='drop'){if(!objects.length){toast('Letakkan benda dari rak terlebih dahulu.');return}arrangeForce();running=true;elapsed=0;sim={type:action};result(action==='push'?'Balok meluncur, lalu melambat karena gaya gesek.':'Benda dilepas dari ketinggian sama dan jatuh bersamaan.');}if(action==='simple'){if(evaluateSimple()){running=true;elapsed=0;sim={type:'simple',progress:0}}}if(action==='heat'){if(!has('cup')||!objects.some(o=>/spoon/.test(o.id))){toast('Tambahkan air panas dan sendok terlebih dahulu.');return}running=true;result('Panas mengalir dari air ke ujung sendok lalu merambat menuju gagang. Bandingkan suhu gagang.')}if(action==='pause'){running=false;result('Pengamatan dijeda. Tekan Mulai pengamatan untuk melanjutkan.',`Waktu model: ${Math.round(heatTime)} detik`)}if(action==='switch'){closed=!closed;document.querySelector('[data-action="switch"]').textContent=closed?'⏻ Buka sakelar':'⏻ Tutup sakelar';evaluateElectric();render()}if(action==='auto')autoWire();if(action==='clearwires'){wires=[];terminal=null;evaluateElectric();render()}}
$('#tabs').onclick=e=>{let b=e.target.closest('[data-lab]');if(b){lab=b.dataset.lab;mode=0;reset()}};$('#modes').onclick=e=>{let b=e.target.closest('[data-mode]');if(b){mode=Number(b.dataset.mode);reset()}};
$('#answers').onclick=e=>{let b=e.target.closest('[data-answer]');if(!b)return;$('#answers').querySelectorAll('button').forEach(x=>x.classList.remove('chosen'));b.classList.add('chosen');$('#feedback').textContent=(Number(b.dataset.answer)===labs[lab].answer?'Tepat! ':'Coba perhatikan lagi. ')+labs[lab].explain};
$('#controls').onclick=e=>{let b=e.target.closest('[data-action]');if(b)act(b.dataset.action)};
$('#controls').oninput=e=>{let id=e.target.id,v=e.target.value;if(id in settings){settings[id]=['surface','pulley'].includes(id)?v:Number(v);let out=$('#'+id+'Val');if(out)out.textContent=v+(id==='angle'?'°':id==='fulcrum'?'%':id==='height'?' m':' m/s');if(lab==='simple'){running=false;sim=null;evaluateSimple()}if(lab==='force')arrangeForce();render()}if(id==='testMaterial'){testMaterial=v;evaluateElectric();render()}};
$('#help').onclick=()=>{guideVisible=!guideVisible;$('.info').classList.toggle('hidden-guide',!guideVisible);$('#help').setAttribute('aria-expanded',guideVisible);if(guideVisible&&innerWidth<650)$('#guide').scrollIntoView({behavior:'smooth',block:'nearest'})};$('#help').setAttribute('aria-expanded','true');$('#reset').onclick=reset;$('#remove').onclick=()=>{objects=objects.filter(o=>o.uid!==selected);wires=wires.filter(w=>w.every(t=>!t.startsWith(selected+':')));selected=null;clearSelection();evaluate();render()};
function point(e){const r=stage.getBoundingClientRect();return{x:(e.clientX-r.left)/r.width*800,y:(e.clientY-r.top)/r.height*440}}
let drag=null;
$('#shelf').addEventListener('pointerdown',e=>{let b=e.target.closest('[data-item]');if(!b||e.button>0)return;e.preventDefault();b.setPointerCapture(e.pointerId);drag={kind:'new',id:b.dataset.item,startX:e.clientX,startY:e.clientY,moved:false,button:b};choose(b.dataset.item)});
$('#shelf').addEventListener('pointermove',e=>{if(!drag||drag.kind!=='new')return;if(Math.hypot(e.clientX-drag.startX,e.clientY-drag.startY)>7){drag.moved=true;if(!drag.ghost){let g=document.createElement('div');g.className='ghost';g.innerHTML=icon(drag.id);document.body.append(g);drag.ghost=g}drag.ghost.style.left=e.clientX+'px';drag.ghost.style.top=e.clientY+'px'}});
function endShelf(e,cancel=false){if(!drag||drag.kind!=='new')return;const d=drag;drag=null;d.ghost?.remove();if(cancel)return;if(!d.moved&&innerWidth<650)$('#stageWrap').scrollIntoView({behavior:'smooth',block:'center'});if(d.moved){const r=stage.getBoundingClientRect();if(e.clientX>=r.left&&e.clientX<=r.right&&e.clientY>=r.top&&e.clientY<=r.bottom){const p=point(e);add(d.id,p.x,p.y)}else toast('Lepaskan bahan di meja percobaan.')}}
$('#shelf').addEventListener('pointerup',e=>endShelf(e));$('#shelf').addEventListener('pointercancel',e=>endShelf(e,true));$('#shelf').addEventListener('click',e=>{if(e.detail===0){const b=e.target.closest('[data-item]');if(b)choose(b.dataset.item)}});
stage.addEventListener('pointerdown',e=>{if(e.button>0)return;const term=e.target.closest('[data-terminal]');if(term){let t=term.dataset.terminal;if(terminal&&terminal!==t){if(terminal.split(':')[0]===t.split(':')[0])toast('Hubungkan terminal dari dua komponen berbeda.');else if(!wires.some(w=>w.includes(t)&&w.includes(terminal)))wires.push([terminal,t]);terminal=null;evaluateElectric()}else{terminal=t;toast('Sekarang ketuk terminal komponen lain.')}render();return}const p=point(e);if(pending){add(pending,p.x,p.y);return}const g=e.target.closest('[data-uid]');if(g){selected=Number(g.dataset.uid);clearSelection();const o=objects.find(o=>o.uid===selected);if(lab==='magnet'||lab==='electric'){stage.setPointerCapture(e.pointerId);drag={kind:'move',uid:o.uid,dx:p.x-o.x,dy:p.y-o.y}}else if(lab==='heat')toast('Nyalakan lilin untuk memanaskan air.');render()}else{selected=null;terminal=null;clearSelection();render()}});
stage.addEventListener('pointermove',e=>{if(!drag||drag.kind!=='move')return;const o=objects.find(o=>o.uid===drag.uid);if(!o)return;const p=point(e);o.x=clamp(p.x-drag.dx,75,725);o.y=clamp(p.y-drag.dy,85,350);render()});
stage.addEventListener('pointerup',()=>{if(drag?.kind==='move'){drag=null;if(lab==='electric')evaluateElectric()}});stage.addEventListener('pointercancel',()=>{drag=null});
function tick(t){let dt=Math.min((t-last)/1000||0,.04);last=t;let redraw=false;if(lab==='magnet'){const mags=objects.filter(o=>o.id==='magnet');let found='';for(const m of mags){for(const o of objects){if(o===m||drag?.uid===o.uid)continue;let dx=m.x-o.x,dy=m.y-o.y,d=Math.hypot(dx,dy);if(['nail','clip'].includes(o.id)&&d<175&&d>80){o.x+=dx*dt*2;o.y+=dy*dt*2;redraw=true;found=items[o.id][0]+' tertarik magnet karena mengandung besi atau baja.'}}}if(mags.length>=2){for(let i=0;i<mags.length;i++)for(let j=i+1;j<mags.length;j++){let a=mags[i],b=mags[j],left=a.x<b.x?a:b,right=a.x<b.x?b:a,dx=right.x-left.x,dy=right.y-left.y,d=Math.hypot(dx,dy);if(d<235&&Math.abs(dy)<70){const attract=left.flip===right.flip;found=attract?'Kutub berlainan saling tarik-menarik.':'Kutub senama saling tolak-menolak.';let f=attract?1:-1;if((attract&&d>132)||(!attract&&d<220)){if(drag?.uid!==left.uid)left.x=clamp(left.x+f*dt*45,75,725);if(drag?.uid!==right.uid)right.x=clamp(right.x-f*dt*45,75,725);redraw=true}}}}if(found&&$('#result').textContent!==found)result(found)}
if(running){elapsed+=dt;redraw=true;if(lab==='force'&&sim){if(sim.type==='push'){const mu=settings.surface==='licin'?.1:.4,a=mu*9.8,v=settings.speed,stop=v/a,time=Math.min(elapsed,stop),dist=v*time-.5*a*time*time;objects.forEach(o=>{o.x=105+dist*95;o.y=300});result('Balok melambat akibat gaya gesek. Coba bandingkan dengan permukaan '+(settings.surface==='licin'?'kasar.':'licin.'),`Jarak: ${dist.toFixed(2)} m · kecepatan: ${Math.max(0,v-a*time).toFixed(2)} m/s`);if(elapsed>=stop)running=false}else{let duration=Math.sqrt(2*settings.height/9.8),time=Math.min(elapsed/2,duration),fraction=.5*9.8*time*time/settings.height;objects.forEach(o=>o.y=95+fraction*235);result('Benda yang dilepas bersamaan dari tinggi sama tiba bersamaan dalam model tanpa hambatan udara.',`Waktu jatuh: ${time.toFixed(2)} s · massa: ${settings.mass} kg`);if(elapsed/2>=duration)running=false}}if(lab==='simple'&&sim){sim.progress=Math.min(1,elapsed/2);if(sim.progress>=1)running=false}if(lab==='heat'){heatTime+=dt*5;objects.forEach(o=>{if(/spoon/.test(o.id)){let k=o.id==='metalspoon'?.065:o.id==='woodspoon'?.004:.007;o.temp=25+55*(1-Math.exp(-k*heatTime))}});result('Gagang logam lebih cepat hangat. Warna jingga menunjukkan kenaikan suhu gagang.',`Waktu model: ${Math.round(heatTime)} s · air: 80 °C`);if(heatTime>=180){running=false;result('Pengamatan selesai. Logam menghantarkan panas paling cepat; kayu dan plastik lebih lambat.','Suhu dan waktu merupakan model ilustratif.')}}}if(redraw)render();requestAnimationFrame(tick)}
setup();requestAnimationFrame(tick);
